MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=concn_datahub
MYSQL_USER=concn_app
MYSQL_PASSWORD=replace-with-application-password
CONCN_ENV=development
CONCN_PUBLIC_URL=http://localhost:5173
CONCN_REQUIRE_VERIFIED_EMAIL=0
CONCN_JOB_ROOT=./jobs
CONCN_MAX_ACTIVE_JOBS=2
CONCN_MAX_QUEUE=50
CONCN_TASK_TIMEOUT=3600
CONCN_MAX_ZIP_BYTES=2147483648
CONCN_MIN_FREE_BYTES=1073741824
CONCN_COOKIE_SECURE=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
