MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=concn_datahub
MYSQL_USER=concn_app
MYSQL_PASSWORD=replace-with-application-password
# 监听地址和端口。默认 127.0.0.1:8000 只接受本机访问；
# 需要从外部访问时设为 0.0.0.0，并确认防火墙/安全组已放行该端口。
CONCN_HOST=127.0.0.1
CONCN_PORT=8000
CONCN_ENV=development
CONCN_PUBLIC_URL=http://localhost:5173
CONCN_REQUIRE_VERIFIED_EMAIL=0
CONCN_JOB_ROOT=./jobs
CONCN_MAX_ACTIVE_JOBS=2
CONCN_MAX_QUEUE=50
CONCN_TASK_TIMEOUT=3600
CONCN_MAX_ZIP_BYTES=2147483648
CONCN_MIN_FREE_BYTES=1073741824
CONCN_COOKIE_SECURE=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Linux worker uses the source paths in concnshare/config.py; override as needed.
# CONCN_SHP_DIR=/data/share/parflow-group/CONCN_Subbasins_Map/PFBAS/shp
# CONCN_TIF_DIR=/data/share/parflow-group/CONCN_Subbasins_Map/PFBAS/geotiff
# CONCN_INPUT_PFB_DIR=/data/share/parflow-group/CONCN1.1/inputs
# PARFLOW_PFMASK_CMD=/path/to/pfmask-to-pfsol
# 写入裁切包 metadata 的数据版本号，默认 1.1。
# CONCN_DATA_VERSION=1.1
# 仅独立裁切 CLI（python -m concnshare.run_two）用；网站 worker 使用 CONCN_JOB_ROOT。
# OUTPUT_DIR=./outputs
